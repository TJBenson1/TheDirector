{
  "name": "the-director",
  "version": "1.0.0",
  "private": true,
  "description": "The Director — a counterfactual football management simulation (1995–2025)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "harness": "pnpm --filter @director/harness run harness",
    "check": "pnpm typecheck && pnpm test && pnpm harness"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
